#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
external-monitor-ls - connected display outputs

Usage:
  external-monitor-ls
  external-monitor-ls --help
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ -n "${1:-}" ]]; then
  usage >&2
  exit 2
fi

if [[ -z "${SWAYSOCK:-}" ]]; then
  echo "ERROR: SWAYSOCK is not set. Run this inside Sway." >&2
  exit 1
fi

swaymsg -t get_outputs | jq -r '.[].name'
