#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
external-monitor-off - restore laptop display only

Usage:
  external-monitor-off
  external-monitor-off --help
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ -n "${1:-}" ]]; then
  usage >&2
  exit 2
fi

if [[ -z "${DISPLAY:-}" ]]; then
  echo "ERROR: DISPLAY is not set. Run this inside X11." >&2
  exit 1
fi

laptop_output="${EXTERNAL_MONITOR_LAPTOP_OUTPUT:-eDP-1}"
mapfile -t connected_outputs < <(xrandr --query | awk '$2 == "connected" { print $1 }')

laptop_connected=false
for connected_output in "${connected_outputs[@]}"; do
  if [[ "$connected_output" == "$laptop_output" ]]; then
    laptop_connected=true
  fi
done

if [[ "$laptop_connected" != true ]]; then
  for connected_output in "${connected_outputs[@]}"; do
    if [[ "$connected_output" == eDP-* ]]; then
      laptop_output="$connected_output"
      laptop_connected=true
      break
    fi
  done
fi

if [[ "$laptop_connected" != true ]]; then
  echo "ERROR: laptop output is not connected: $laptop_output" >&2
  echo "Open the laptop lid and try again." >&2
  exit 1
fi

xrandr --output "$laptop_output" --auto
for connected_output in "${connected_outputs[@]}"; do
  if [[ "$connected_output" != "$laptop_output" ]]; then
    xrandr --output "$connected_output" --off
  fi
done
